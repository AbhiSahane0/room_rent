{
  "expo": {
    "name": "Rent Manager",
    "slug": "rent-manager",
    "scheme": "rentmanager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F7F9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rentmanager.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Rent Manager uses the camera to capture tenant documents such as Aadhaar and PAN.",
        "NSPhotoLibraryUsageDescription": "Rent Manager lets you choose tenant documents from your photo library."
      }
    },
    "android": {
      "package": "com.rentmanager.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose tenant documents from your photo library.",
          "cameraPermission": "Capture tenant documents with the camera."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Capture tenant documents with the camera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
